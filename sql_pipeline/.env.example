# Copy to .env and fill in real values. Never commit .env.

# Neon Postgres (pooled endpoint is fine for this project)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxx-pooler.region.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require

# Groq API (used only for the optional LLM vehicle-extraction fallback)
GROQ_API_KEY=gsk_your_key_here
# Optional: override the Groq model (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b
