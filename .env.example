# Copy to .env (repo root) and fill in real values. Never commit .env.
# The backend also still reads sql_pipeline/.env if you keep one there.

# Neon Postgres (pooled endpoint is fine)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxx-pooler.region.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require

# Groq API: vehicle-extraction fallback, RAG severity tagging, final synthesis
GROQ_API_KEY=gsk_your_key_here
# Optional: model for the extractor fallback + final synthesis (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b
# Optional: comma-separated models tried when the main one hits its Groq quota (default below)
# GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b
